[Unit]
Description=Unlock root volume with recovery key from RESCUE_DATA
After=initrd-swtpm.service systemd-tpm2-setup-early.service
Before=systemd-cryptsetup@root.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes

EnvironmentFile=/usr/lib/os-release
Environment=TTYS="/dev/tty1 /dev/ttyS0"

ExecStart=/usr/bin/initrd-recovery-key.sh
